<Project Sdk="Microsoft.NET.Sdk">
   <PropertyGroup>
      <OutputType>Exe</OutputType>
      <TargetFramework>net10.0</TargetFramework>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="FluentNHibernate" Version="3.4.1" />
      <PackageReference Include="KitchenPC.Core" Version="2.0.0" />
      <PackageReference Include="KitchenPC.DB" Version="2.0.0" />
      <PackageReference Include="NHibernate" Version="5.7.0" />
      <PackageReference Include="Npgsql" Version="10.0.3" />
   </ItemGroup>

   <ItemGroup>
      <None
         Include="..\SampleData\KPCData.xml"
         Link="SampleData\KPCData.xml"
         CopyToOutputDirectory="PreserveNewest"
      />
   </ItemGroup>
</Project>
